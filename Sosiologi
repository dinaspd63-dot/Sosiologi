    <script>
        // Toggle jawaban accordion
        function toggleJawab(el) {
            const jawab = el.nextElementSibling;
            if (jawab) {
                jawab.classList.toggle('show');
                el.classList.toggle('active');
            }
        }

        // Pilihan ganda
        function pilihJawaban(option, pilihan, quizId) {
            // cari container quiz
            const quizContainer = document.getElementById(quizId);
            // kunci jawaban
            let kunci = '';
            if (quizId === 'quiz1') kunci = 'B';
            else if (quizId === 'quiz2') kunci = 'D';

            // cari semua opsi di quiz tsb
            const options = quizContainer.querySelectorAll('.quiz-option');
            const feedback = quizContainer.querySelector('.feedback');

            // jika sudah pernah dijawab (ada class correct/wrong), reset dulu? 
            // kita nonaktifkan klik berulang dengan menghapus onclick? biar sederhana kita cegah jika sudah ada correct.
            let sudahDijawab = false;
            options.forEach(opt => {
                if (opt.classList.contains('correct') || opt.classList.contains('wrong')) {
                    sudahDijawab = true;
                }
            });
            if (sudahDijawab) return;

            // tandai pilihan
            if (pilihan === kunci) {
                option.classList.add('correct');
                feedback.textContent = '✅ Tepat sekali! Analisis sosiologis yang cermat.';
                feedback.className = 'feedback feedback-ok';
            } else {
                option.classList.add('wrong');
                feedback.textContent = '❌ Kurang tepat. Coba pahami lagi perspektif sosiologinya.';
                feedback.className = 'feedback feedback-no';
                // tampilkan jawaban yang benar (opsional: tandai yg benar)
                options.forEach(opt => {
                    // kita deteksi teks mengandung kunci? lebih aman pakai indeks
                    // kita cari opsi yg sesuai kunci: A/B/C/D
                    const text = opt.textContent.trim();
                    if (text.startsWith(kunci + '.')) {
                        opt.classList.add('correct');
                    }
                });
            }
            // nonaktifkan klik lebih lanjut dengan menghapus onclick? biarkan tapi dicegah oleh sudahDijawab
        }

        // Tutup accordion lain ketika membuka yang baru? tidak perlu, biarkan multi.
        // Inisialisasi: sembunyikan semua jawaban
        document.querySelectorAll('.jawab').forEach(j => j.classList.remove('show'));
    </script>
